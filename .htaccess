RewriteEngine On

# Force HTTPS redirection
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Block direct web downloads of SQLite database files, journals, and backups
<FilesMatch "\.(sqlite|db|db-journal|sqlite-journal|sqlite-shm|sqlite-wal|sql|bak)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Block direct access to the admin credentials file (defense in depth)
<FilesMatch "^admin_config(\.example)?\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# Route API endpoints cleanly
RewriteRule ^api/disponibilidad/?$ api/disponibilidad.php [L,QSA]
RewriteRule ^api/reservas/?$ api/reservas.php [L,QSA]
RewriteRule ^admin/citas/?$ api/admin_citas.php [L,QSA]

# Route admin.html to admin.php as a fallback
RewriteRule ^admin\.html$ admin.php [L]
